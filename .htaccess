# ==========================================================================
# JG Solutions – Apache-Konfiguration (IONOS Webhosting)
# Saubere URLs (/kontakt statt /kontakt.html), HTTPS, eine Domain-Variante
# (ohne www, wie Canonical und Sitemap), Kompression, Caching, Sicherheits-Header.
# ==========================================================================

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest

# Es gibt die Datei leistungen.html und den Ordner /leistungen/. Ohne diese Zeile
# leitet Apache /leistungen auf /leistungen/ um und die Seite wäre nicht erreichbar.
DirectorySlash Off

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Arbeitsordner sperren (am besten gar nicht erst hochladen)
RewriteRule ^(_[^/]*|docs|node_modules|\.git|\.claude[^/]*)(/|$) - [F,L]

# HTTPS + ohne www in einem Schritt (eine einzige 301-Weiterleitung)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://jg-solutions.eu%{REQUEST_URI} [L,R=301,NE]

# Alte Leistungsseiten (bis Oktober 2026) -> gebündelte neue Seiten
RewriteRule ^leistungen/seo(\.html)?/?$ /leistungen/webseiten [R=301,L]
RewriteRule ^leistungen/(automatisierungen|ki)(\.html)?/?$ /leistungen/automatisierung-ki [R=301,L]
RewriteRule ^leistungen/(branding|visitenkarten)(\.html)?/?$ /leistungen/branding-print [R=301,L]

# /index und /index.html (auch in Unterordnern) -> Ordner-URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/(.*/)?index(\.html)?[\s?]
RewriteRule ^ /%1 [R=301,L]

# /seite.html -> /seite (nur bei direktem Aufruf, THE_REQUEST verhindert Schleifen)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\s/(.+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# /leistungen/ -> /leistungen (wenn es dazu eine .html-Datei gibt)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /seite -> seite.html intern ausliefern
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ---------- Interne Dateien sperren ----------
<IfModule mod_authz_core.c>
<FilesMatch "(^\.|\.(zip|rar|7z|md|py|mjs|bak|old|orig|tmp|swp|sql|log|ini|ps1|sh|json|geojson|psd|ai|fig|sketch)$)">
  Require all denied
</FilesMatch>
</IfModule>

# ---------- Sicherheits-Header ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

  # Kein Inline-JavaScript, alles liegt in /js/. Fremde Quellen nur für Cal.com,
  # das erst nach Klick auf „Kalender laden“ nachgeladen wird.
  # 'unsafe-inline' bei style-src braucht Cal.com für seine Inline-Styles.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://app.cal.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.cal.com; font-src 'self'; connect-src 'self' https://app.cal.com https://api.cal.com; frame-src https://app.cal.com https://cal.com; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # HSTS erst aktivieren, wenn HTTPS sicher läuft (Zertifikat bei IONOS aktiv):
  # Header always set Strict-Transport-Security "max-age=31536000"

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS: 1 Woche. Bei Änderungen VERSION in _werkzeuge/seiten-bauen.mjs erhöhen und neu bauen.
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ---------- Kompression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript image/svg+xml application/manifest+json
</IfModule>
